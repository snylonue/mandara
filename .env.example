# Mandara server configuration (also settable via CLI flags).
# Copy to `.env` and adjust. See README.md for the full table.

# MANDARA_ADDR=127.0.0.1:8080
# MANDARA_DB=data/mandara.db
# MANDARA_DATA_DIR=data
# MANDARA_PLUGINS_DIR=data/plugins
# MANDARA_JWT_SECRET=change-me-to-a-long-random-string
# MANDARA_JWT_SECRET_FILE=/run/credentials/mandara.service/jwt-secret
# MANDARA_ALLOW_REGISTER=true
# MANDARA_MAX_UPLOAD_MB=64
# MANDARA_FRONTEND_DIR=frontend