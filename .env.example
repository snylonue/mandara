# Bookshelf server configuration (also settable via CLI flags).
# Copy to `.env` and adjust. See README.md for the full table.

# BOOKSHELF_ADDR=127.0.0.1:8080
# BOOKSHELF_DB=data/bookshelf.db
# BOOKSHELF_DATA_DIR=data
# BOOKSHELF_PLUGINS_DIR=data/plugins
# BOOKSHELF_JWT_SECRET=change-me-to-a-long-random-string
# BOOKSHELF_AUTH_ENABLED=true
# BOOKSHELF_ALLOW_REGISTER=true
# BOOKSHELF_MAX_UPLOAD_MB=64
# BOOKSHELF_FRONTEND_DIR=frontend