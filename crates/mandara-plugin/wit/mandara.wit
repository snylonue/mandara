// Plugin protocol v14: book-scoped content choices for explicit file selection.
// Plugins adapt upstream data and define opaque, stable IDs.
// Metadata/content source selection belongs exclusively to the host.

package mandara:plugin@0.14.0;

/// Shared types between mandara and plugins.
interface types {
    /// One field of the configuration schema.
    record config-field {
        /// Stable key; the value is stored in JSON under this key.
        key: string,
        /// zh-CN display label rendered by the admin form.
        label: string,
        kind: config-kind,
        /// Serialized default value (JSON), e.g. `"10"` or `"false"`.
        default: option<string>,
        required: bool,
        hint: option<string>,
    }

    /// Field kinds. `enum` options are rendered as a select and the
    /// config value is the option index; `list-of-string` is a
    /// newline/comma separated text area in the UI.
    /// (`string` is a WIT keyword, hence the `text` case name.)
    variant config-kind {
        text,
        number,
        boolean,
        enum-options(list<string>),
        list-of-string,
    }

    /// A validated configuration value, in `config-schema` field order.
    variant config-value {
        text(string),
        number(f64),
        boolean(bool),
        enum-index(u32),
        string-list(list<string>),
    }

    /// Series metadata, distinct from an individual volume.
    record series-entry {
        id: string,
        title: string,
        authors: list<string>,
        description: option<string>,
        cover-url: option<string>,
        /// SeriesExt JSON object, validated by the host.
        extra: option<string>,
    }

    /// Content loading is selected by the plugin, never inferred by the host.
    enum content-mode { chapters, file }

    /// A book offered by a plugin source.
    record book-entry {
        /// Stable id of the book within this plugin.
        id: string,
        title: string,
        authors: list<string>,
        description: option<string>,
        cover-url: option<string>,
        /// Optional extended metadata as a JSON object (`BookExt` shape:
        /// subtitle/original-title/isbn/publisher/pub-date/translators/
        /// illustrators/pages/price/binding/language + free-form extras;
        /// per-volume publication fields). The host
        /// validates it — malformed objects fail the call.
        extra: option<string>,
        /// Parent series metadata supplied by this plugin, or none.
        series: option<series-entry>,
        /// Display order within the series; zero for standalone books.
        volume-no: u32,
    }

    /// A single chapter of a book.
    record chapter {
        title: string,
        /// A supplied body, including an empty string.
        content: string,
        /// "text" = plain text normalized by the host; "html" = HTML
        /// fragment sanitized by the host before storage.
        format: string,
    }

    /// A declared chapter, optionally supplied with its body.
    record declared-chapter {
        title: string,
        /// none = fetch lazily via get-chapter; some("") = cached empty body.
        content: option<string>,
        /// Same interpretation as chapter.format.
        format: string,
    }

    /// Content identity and loading, independent of book metadata.
    record declared-content {
        id: string,
        mode: content-mode,
        chapters: list<declared-chapter>,
    }

    /// A selectable content file or chapter collection, not book metadata.
    record content-option {
        id: string,
        title: string,
        available: bool,
    }

    /// A catalog association between metadata and optional content.
    /// Their IDs are independent; neither record contains the other.
    record declared-book {
        book: book-entry,
        content: option<declared-content>,
    }

    /// Paginated catalog search result.
    record search-result {
        /// Source-side total number of matches (may be capped by the
        /// source; the host relies on pagination, not on this number).
        total: u64,
        items: list<catalog-entry>,
    }

    variant catalog-entry {
        single(book-entry),
        series(series-entry),
    }

    /// Every member has a stable metadata ID accepted by get-book.
    /// Content IDs are independent and selected separately.
    record series-result {
        series: series-entry,
        books: list<book-entry>,
    }

    /// A whole book as the source stores it (epub/txt download).
    ///
    /// The host parses `bytes` with the same pipeline as uploads
    /// (chapters, hierarchical TOC, sanitized HTML), so file-mode books
    /// are stored like local files — the plugin is not consulted for
    /// content afterwards.
    record book-file {
        /// Original download name, e.g. `"mystery-ep1.epub"`. The
        /// extension selects the parser.
        filename: string,
        /// `"application/epub+zip"` | `"text/plain"` | `"text/plain; charset=utf-8"` | ...
        mime: string,
        bytes: list<u8>,
    }

    /// How the frontend should present this plugin source when a user
    /// acquires books from it (获取书籍). Advisory: the UI falls back to
    /// the capabilities-derived default when the declared kind is
    /// unsupported (e.g. a future kind a new frontend does not know yet).
    record source-info {
        /// Interaction kind used to acquire books:
        ///   - `"search"`    — the catalog is browsed with a query box
        ///     (`search-books`; requires the `search` capability);
        ///   - `"manual-id"` — no search; users enter a book id directly
        ///     (requires `lookup`; wenku8-style sources);
        ///   - `"browse"`    — a declared category tree (`declare`;
        ///     reserved for future frontends).
        /// The capability default when `""`/unknown: `search` →
        /// `"search"`, `lookup`-only → `"manual-id"`, `declare`-only →
        /// `"browse"`.
        kind: string,
        /// What a manual book id looks like, e.g. `"numeric"`,
        /// `"slug"`, `"uuid"`. Not enforced; only shapes UI hints.
        id-kind: string,
        /// zh-CN hint for the manual id entry, e.g.
        /// `"wenku8 数字书号（如 3617）"`.
        id-hint: option<string>,
        /// zh-CN placeholder for the search box, e.g. `"搜索书名 / 作者"`.
        search-hint: option<string>,
    }
}

/// Functions provided by the host (the mandara server).
interface store {
    /// Append a line to the server log, tagged with the instance id.
    log: func(message: string);

    /// Store image bytes in the server's content-addressed image store.
    ///
    /// The id is the sha256 of the bytes (hex): identical bytes return the
    /// same id, so images dedup across chapters and books. Reference a
    /// stored image in chapter content as `<img src="/api/images/{id}">`
    /// — that exact form is the canonical reference every producer
    /// (plugins and epub upload ingest) converges on.
    ///
    /// Per-image and per-call byte budgets are host caps; exceeding them
    /// traps the call. Fails (traps) when the store cannot persist the
    /// bytes.
    store-image: func(bytes: list<u8>, mime: string) -> string;
}

/// Persistent state scoped by the host to the calling plugin instance.
/// Values survive calls and restarts until overwritten or deleted; no TTL
/// or versions. Operations are individually atomic, not read/modify/write.
interface state {
    /// Missing keys return none; an empty byte buffer is a stored value.
    get: func(key: string) -> result<option<list<u8>>, string>;
    /// Replace the entire value. Concurrent writes are last-writer-wins.
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// Return true only when a stored key was removed.
    delete: func(key: string) -> result<bool, string>;
}

/// Outbound HTTP (see docs/plugin-http-api-design.md §3.1).
///
/// This is the only network access a plugin gets. The host caps timeout,
/// response size and redirect count. The plugin decides what an
/// application-level status (404, ...) means: `fetch` only fails on
/// transport-level problems.
interface http {
    /// One HTTP header (name/value pair).
    record header {
        name: string,
        value: string,
    }

    /// A request the plugin wants the host to perform.
    record request {
        /// "GET", "POST", ... (host normalizes case).
        method: string,
        /// Absolute http(s) URL.
        url: string,
        /// Plugin-controlled headers. The host sends exactly these (plus
        /// the ones it manages itself) — nothing ambient, no cookies.
        headers: list<header>,
        body: option<list<u8>>,
        /// Desired timeout; the host enforces
        /// `min(requested, MANDARA_PLUGIN_FETCH_TIMEOUT_MS)`.
        timeout-ms: option<u64>,
    }

    /// The response as received. `status` is always the raw HTTP status —
    /// including 4xx/5xx, which are *not* errors.
    record response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
        /// URL after redirects (host-validated hops).
        final-url: string,
    }

    /// Transport-level outcome. Application-level statuses (404, ...) are
    /// *not* errors — the plugin inspects `response.status`.
    variant fetch-error {
        /// Permanent: URL parse/protocol problem.
        invalid-url(string),
        /// Permanent: host policy rejected the URL/scheme/address.
        denied(string),
        /// Permanent: too many redirect hops (host cap).
        redirect-limit(u32),
        /// Transient: took longer than the (capped) timeout.
        timeout(u64),
        /// Permanent: response exceeded the size cap (no partial data).
        size-limit(u64),
        /// Transient-if-connect: DNS/TLS/connection problem.
        transport(string),
    }

    /// Perform one HTTP request. Only `url`, `method` and the given
    /// `headers`/`body` are sent; the host never adds credentials.
    fetch: func(request: request) -> result<response, fetch-error>;
}

/// World implemented by mandara plugins.
///
/// A plugin is a stateless component that offers metadata (and optionally
/// content) for books. The server registers *instances* of a plugin (one
/// wasm file can back several instances with different configurations),
/// validates configuration against `config-schema`, and materializes
/// books/chapters into the central library. Guest memory is per-call;
/// the state import provides durable, instance-scoped storage.
world mandara-plugin {
    import types;
    import store;
    import state;
    import http;

    // Types used by this world's exports come from the imported `types`
    // interface; WIT requires an explicit `use` to bring them into the
    // world scope.
    use types.{config-field, config-value, book-entry, content-mode, chapter, declared-chapter, declared-content, content-option, declared-book, search-result, book-file, source-info, series-entry, series-result, catalog-entry};

    /// Human-readable plugin name, read in the registered instance context.
    export name: func() -> string;

    /// How users acquire books from this plugin (interaction kind +
    /// hints). The host exposes it via `GET /api/plugins` so the UI can
    /// render the right picker without hardcoding a specific source.
    export source-info: func() -> source-info;

    /// Configuration schema; the host renders an admin form from it and
    /// validates submitted values against it.
    export config-schema: func() -> list<config-field>;

    /// Catalog access patterns implemented by this plugin: a subset of
    /// ["declare", "search", "lookup", "identify", "content", "book-file"].
    ///
    /// Host policy:
    ///   - `declare`  -> the catalog is fully synced at startup / on sync;
    ///   - `search`   -> the catalog is browsed with `search-books`;
    ///   - `lookup`   -> single books can be fetched with `get-book`
    ///     (materialize-on-demand, refresh);
    ///   - `identify` -> the source takes part in upload identification;
    ///   - `content-list` -> enumerate content choices by book ID or URL;
    ///   - `content`  -> the source declares chapters via `get-content` and
    ///     supplies missing bodies via `get-chapter` (chapter mode);
    ///   - `book-file`-> the source provides whole book files via
    ///     `get-book-file` (file mode). These are discovery hints; the
    ///     content declaration selects loading. Plugins own fallback.
    /// Metadata-only plugins declare everything except `content`/
    /// `book-file`.
    export capabilities: func() -> list<string>;

    /// Business exports receive validated configuration explicitly, in schema order.
    /// Metadata and schema exports do not receive configuration.
    ///
    /// Full static catalog, when it is small enough to enumerate eagerly
    /// (host cap: a few thousand books). `none` when the source is large
    /// or has no books; use `search-books`/`get-book` instead.
    export declare: func(config: list<config-value>) -> option<list<declared-book>>;

    /// Paginated catalog search (large sources). `query` may be empty to
    /// page through everything; the host clamps `limit`/`offset`.
    export search-books: func(config: list<config-value>, query: string, offset: u32, limit: u32) -> search-result;

    /// Single book by id (materialize-on-demand, refresh). `none` = not
    /// found.
    export get-book: func(config: list<config-value>, book-id: string) -> option<book-entry>;

    /// List content choices under a user-facing book ID or URL (`content-list`).
    /// none = book unavailable; some([]) = book has no files. No downloads.
    export list-content: func(config: list<config-value>, reference: string) -> option<list<content-option>>;

    /// Declare content identity, loading form and chapters together.
    /// none = content unavailable; this says nothing about metadata.
    /// The host persists the form at acquisition; plugins own fallback.
    export get-content: func(config: list<config-value>, content-id: string) -> option<declared-content>;

    /// Series lookup; IDs may be different from upstream website IDs.
    export get-series: func(config: list<config-value>, series-id: string) -> option<series-result>;

    /// Fetch one chapter of `content-id` by index. `none` means not found.
    export get-chapter: func(config: list<config-value>, content-id: string, index: u32) -> option<chapter>;

    /// Try to identify the book behind an uploaded file.
    ///
    /// `filename` is the original upload name, `file-hash` the sha-256 hex
    /// digest of the file bytes. Return the matching `book-entry` (usually
    /// with an `id` already offered by this source) or `none` when this
    /// plugin does not recognize the file. The server asks every enabled
    /// instance in creation order; the first match supplies the metadata.
    export identify-upload: func(config: list<config-value>, filename: string, file-hash: string) -> option<book-entry>;

    /// Fetch a whole book file (epub/txt download, `book-file` capability).
    /// `none` = unavailable; the host reports missing content, never
    /// changes content mode. Any upstream fallback belongs in this export.
    export get-book-file: func(config: list<config-value>, content-id: string) -> option<book-file>;
}
